# Mimir Environment Configuration Example
# Copy this file to .env to set up local environment variables.

# Database and configuration storage directory.
# If not specified, Mimir defaults to the current working directory.
DATA_DIR=.

# SearXNG instance URL (mandatory for web search capabilities)
SEARXNG_API_URL=http://localhost:4000

# Ollama local inference host URL (defaults to http://localhost:11434)
# Used for loading chat and embedding models locally.
OLLAMA_BASE_URL=http://localhost:11434

# GitHub Personal Access Token (optional)
# Used to bypass standard rate limits on GitHub repository searches.
GITHUB_TOKEN=

# NVIDIA NIM API configuration (optional)
# Trial usage may log input and output.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Configuration Priority:
# 1. Environment variables set at startup (e.g. OLLAMA_BASE_URL, SEARXNG_API_URL).
# 2. Local JSON configuration stored at <DATA_DIR>/data/config.json.
# 3. Client preferences configured through the user interface settings.
